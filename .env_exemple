MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano-2025-08-07,gpt-5.1-chat-latest
BRAVE_SEARCH_API_KEY=
TORCH_NUM_THREADS=
OMP_NUM_THREADS=
# OCR Docling (schémas techniques, cotes, PDF scannés)
DOCLING_OCR_ENABLED=true
DOCLING_OCR_LANG=
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DIMENSION=1024
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
HIERARCHICAL_CHUNK_SIZES=3072,1024,384
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Optionnel: si vide, l'app construit DATABASE_URL avec ces valeurs (fallback)
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Optionnel : override explicite
# DATABASE_URL=postgresql://postgres:postgres@db:5432/noton
SECRET_KEY=
# SQLAlchemy : true = log toutes les requêtes (très verbeux ; les UPDATE d'embeddings remplissent les logs)
# DATABASE_ECHO=false
APP_NAME="LIA - L'Intelligence Artificielle"
MODEL_FAST=mistral-small-latest
MAX_COMPLETION_TOKENS=1024
SPACE_CHAT_MAX_TOKENS=900
# Plan A : température basse forcée pour réduire les hallucinations sur RAG/KAG
SPACE_CHAT_TEMPERATURE=0.1
SPACE_CHAT_TOP_P=
# Override locaux (utilisés par app/routers/chat.py)
SPACE_CHAT_MAX_TOKENS_OVERRIDE=1200
SPACE_CHAT_TEMPERATURE_OVERRIDE=0.1
# Identité de l'assistant (sortie du code en Plan A : plus de "PROFERM" hardcodé).
# Laisse vide pour un assistant générique "documentaire".
SPACE_ASSISTANT_NAME=l'assistant documentaire
SPACE_ASSISTANT_ORG=
# KAG - Knowledge Augmented Generation
KAG_ENABLED=true
# Provider possible: openai | mistral | ollama
KAG_EXTRACTION_PROVIDER=ollama
# Exemple modèle Ollama local
KAG_EXTRACTION_MODEL=ministral-3:3b
# Relations typées (cause, depend_de, …) — 2e appel LLM par chunk
KAG_TYPED_RELATIONS_ENABLED=true
# Plan A : enrichissement parent (résumé + 3 questions + embedding) désactivé
# par défaut — trop coûteux à l'ingestion et impact qualité variable.
KAG_PARENT_ENRICHMENT_ENABLED=false
# Seuil KnowledgeEntity.confidence_score pour le retrieval KAG (NULL = anciennes entités OK)
MIN_ENTITY_CONFIDENCE=0.30
OLLAMA_BASE_URL=http://ollama:11434
CORS_ALLOWED_ORIGINS=ds.proferm.net
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DIMENSION=1024
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
HIERARCHICAL_CHUNK_SIZES=3072,1024,384
MULTIMODAL_ENABLED=true
# Journal dédié au traitement documents bibliothèque/espaces (défaut : logs/library_document_processing.log)
# LIBRARY_DOCUMENT_LOG_PATH=
# Vision : enrichissement des chunks « picture » via API Mistral (Pixtral)
VISION_MODEL=pixtral-12b-2409
VISION_MAX_TOKENS=1500
# Limite d’images analysées par document (vide = illimité)
# VISION_MAX_IMAGES_PER_DOCUMENT=30
DOCLING_OCR_ENABLED=true
DOCLING_OCR_LANG=fr,en
DOCLING_CPU_ONLY=true
DOCLING_USE_GPU=false
OCR_IMAGE_SCALE=3.0
OCR_PREPROCESS_ENABLED=true
OCR_FALLBACK_ENABLED=true
OCR_MIN_TEXT_LENGTH=50
OCR_TESSERACT_CONFIG=--oem 3 --psm 6 -l fra+eng
# Passages envoyés au LLM (chat espace / projet).
# Plan A : 8 → 4. Avec la correction "ne plus écraser la feuille par le parent",
# 4 passages bien ciblés suffisent et le LLM hallucine beaucoup moins.
RAG_TOP_K=4
# Optimisation Reranker sur CPU (Modèle MiniLM = 10x plus rapide)
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_STAGE1_MAX=50
RERANK_STAGE2_POOL=25
RERANKER_TOP_N=60
MAX_RERANK_CANDIDATES=100
# Plan A : 25 → 8 (cohérent avec RAG_TOP_K=4)
MMR_K=8
RERANKER_CANDIDATE_MULTIPLIER=5
KAG_EXTRACTION_CHUNK_BATCH_SIZE=3

# --- Plan A — flags qualité RAG/KAG espace --------------------------------
# A1 — Si false (défaut), le contenu envoyé au LLM reste la FEUILLE matchée
# (avec heading/page en préfixe) plutôt que tout le parent (= souvent tout le
# PDF). Mettre à true pour retrouver l'ancien comportement.
SPACE_INJECT_PARENT_CONTENT=false
# Plafond de caractères du contexte parent ajouté en bonus si la feuille est
# très courte (ex : ligne de tableau).
SPACE_PARENT_CONTEXT_MAX_CHARS=600
SPACE_LEAF_SHORT_THRESHOLD=180
# A3 — Multi-hop désactivé par défaut (trop bruyant sur petits espaces).
SPACE_MULTI_HOP_ENABLED=false
# A5 — CQR (raisonnement d'intention / source primaire) désactivé par défaut
# (1 appel LLM par requête, biais marque).
SPACE_USE_CQR=false
# A6 — Si aucun terme ne matche le fallback lexical, renvoyer une liste vide
# pour laisser le LLM dire « information non disponible » au lieu d'injecter
# des chunks au hasard.
SPACE_EMPTY_ON_NO_MATCH=true
# A7 — Fallback ILIKE du retrieval KAG (wildcards bruyants) désactivé.
SPACE_KAG_ILIKE_FALLBACK=false
# A4 — Boosts (titre + source authority) plafonnés très bas pour ne plus
# écraser les scores RRF.
TITLE_QUERY_BOOST_PER_MATCH=0.02
TITLE_QUERY_BOOST_CAP=0.08
SOURCE_AUTHORITY_BOOST=0.05
# A8 — MMR : pénalité douce sur même parent (au lieu d'exclusion stricte qui
# limitait à 1 passage final sur un PDF mono-section).
MMR_LAMBDA=0.6
MMR_SAME_PARENT_PENALTY=0.15

# --- Plan B — page summaries ------------------------------------------------
# Génère un chunk dérivé `page_summary` par page à l'ingestion (sans LLM),
# puis utilise un canal de retrieval dédié pour projeter vers 1..N feuilles
# de preuve de la même page.
SPACE_PAGE_SUMMARY_ENABLED=true
SPACE_PAGE_SUMMARY_PER_PAGE_LEAVES=2
# Déduplication du contexte final injecté au LLM : max extraits par doc/page.
SPACE_MAX_CONTEXT_LEAVES_PER_PAGE=2
# Poids du canal page_summary dans la fusion RRF.
RRF_PAGE_LIST_WEIGHT=0.65

# --- Plan C — agentic léger (step-back) ------------------------------------
# Si les preuves sont faibles sur la requête originale, relance un retrieval
# avec une reformulation "step-back" plus générale et fusionne les passages.
SPACE_AGENTIC_STEPBACK_ENABLED=true
SPACE_AGENTIC_MIN_SCORE=0.12
SPACE_AGENTIC_MIN_CITED_PASSAGES=2

# Redis + Celery (voir docs/CELERY.md)
# thread = file d'attente threads dans le process web (historique)
# celery = uniquement Celery (nécessite un worker)
# hybrid = Celery d'abord, repli threads si Redis indisponible
TASK_BACKEND_MODE=hybrid
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# RBAC Admin Bootstrap
# Email de l'utilisateur qui sera automatiquement administrateur
ADMIN_EMAIL=admin@example.com
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=noton-rag-kag
# Traces détaillées RAG/KAG dans LangSmith (texte des chunks, rerank, parents, prompts LLM)
TRACE_VERBOSE_TEXT=false
# Limite de caractères par chunk/message dans les traces (0 = illimité)
TRACE_TEXT_MAX_CHARS=12000