# Copier vers .env et renseigner les valeurs obligatoires.
# Les lignes vides utilisent les défauts de app/config.py ou docker-compose.yaml.

# --- Obligatoire (Docker Compose) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
SECRET_KEY=

# --- Mistral (OCR, chat, embeddings API) ---
MISTRAL_API_KEY=
MISTRAL_BASE_URL=
MISTRAL_OCR_MODEL=
MISTRAL_OCR_TIMEOUT=

# --- OpenAI (optionnel) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Embeddings & ingestion (Mistral OCR + LlamaIndex hiérarchique) ---
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
EMBEDDING_BATCH_SIZE=
HIERARCHICAL_CHUNK_SIZES=
# Chunking structurel markdown : utilise MarkdownNodeParser au lieu de HierarchicalNodeParser
# Appliqué uniquement aux nouveaux documents (backward compatible)
# USE_MARKDOWN_STRUCTURED_CHUNKING=false

# Extraction PDF : forcer Mistral OCR pour tous les PDF (désactive pymupdf4llm)
# Utile pour debug ou si qualité pymupdf4llm insuffisante sur certains documents
# PDF_FORCE_OCR=false

# Profondeur de titre pour les parents de section (1 = ex. tout le bloc CATALOGUE EXTERIEURES)
# MARKDOWN_STRUCTURED_PARENT_DEPTH=1

# --- Application ---
APP_NAME=
MODEL_FAST=
MAX_COMPLETION_TOKENS=
CORS_ALLOWED_ORIGINS=
ADMIN_EMAIL=

# --- Chat espaces ---
SPACE_CHAT_MAX_TOKENS=
SPACE_CHAT_TEMPERATURE=0.0
SPACE_CHAT_TOP_P=

# --- RAG / recherche ---
RAG_TOP_K=
MIN_VECTOR_SIMILARITY=

# --- Multimodal (retraitement par page : pymupdf + mistral-small) ---
MULTIMODAL_ENABLED=
MULTIMODAL_PAGE_MODEL=mistral-small-latest
MULTIMODAL_PAGE_DPI=200
MULTIMODAL_PAGE_MAX_TOKENS=6000
VISION_MODEL=
VISION_MAX_TOKENS=
VISION_MAX_IMAGES_PER_DOCUMENT=

# --- Recherche web (function calling, optionnel) ---
BRAVE_SEARCH_API_KEY=

# --- Base de données (local hors Docker : construire DATABASE_URL à la main) ---
# DATABASE_ECHO=

# --- Redis + Celery ---
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Worker Celery : 1 job document lourd à la fois (défaut compose : 1)
CELERY_WORKER_CONCURRENCY=1
# Pages multimodal traitées en parallèle dans un même document (défaut : 3)
MULTIMODAL_PAGE_CONCURRENCY=3
MULTIMODAL_NATIVE_TEXT_MIN_CHARS=100
WINDOW_MAX_INPUT_TOKENS=7000
WINDOW_MAX_PAGES=2
WINDOW_PAGE_OVERLAP=0
MAX_REPORTS_PER_WINDOW=2
MISTRAL_PASS2_TIMEOUT=60
RAG_CHUNK_OVERLAP_TOKENS=40
RETRIEVAL_EXPAND_ENABLED=true
RETRIEVAL_PAGE_RADIUS=1
RERANK_GROUP_CHAR_CAP=2800
TASK_BACKEND_MODE=

# --- Ollama (optionnel, profile docker compose « ollama ») ---
OLLAMA_BASE_URL=

# --- LangSmith (observabilité RAG, optionnel) ---
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=
LANGCHAIN_PROJECT=

# --- Journal documents bibliothèque/espaces (optionnel) ---
# LIBRARY_DOCUMENT_LOG_PATH=


APP_NAME="LIA"
MODEL_FAST=mistral-large-latest
KAG_ENABLED=true
KAG_EXTRACTION_PROVIDER=mistral
KAG_EXTRACTION_MODEL=ministral-3b-latest
CORS_ALLOWED_ORIGINS=
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DIMENSION=1024
EMBEDDING_MODEL=mistral-embed
EMBEDDING_DEVICE=cpu
HIERARCHICAL_CHUNK_SIZES=1024,256
# Fenêtres glissantes sur blocs texte longs Docling (rappel)
USE_MARKDOWN_STRUCTURED_CHUNKING=true
PDF_FORCE_OCR=false
MULTIMODAL_ENABLED=true
VISION_MODEL=pixtral-12b-2409
VISION_MAX_TOKENS=1500
DOCLING_OCR_ENABLED=true
DOCLING_OCR_LANG=fr,en
DOCLING_CPU_ONLY=true
DOCLING_USE_GPU=false
OCR_IMAGE_SCALE=3.0
OCR_PREPROCESS_ENABLED=true
OCR_FALLBACK_ENABLED=true
OCR_MIN_TEXT_LENGTH=50
OCR_TESSERACT_CONFIG=--oem 3 --psm 6 -l fra+eng

# === RAG Core ===
RAG_TOP_K=15
MIN_VECTOR_SIMILARITY=0.25

# === Connaissances feedback (double recherche RAG) ===
FEEDBACK_KNOWLEDGE_TITLE_PREFIX=Connaissance technique
FAQ_TOP_K=3
FAQ_MIN_SIMILARITY=0.30
FAQ_POST_DRAFT_ENABLED=false

# === RRF Dynamique (sélection adaptative hybride) ===
RRF_DYNAMIC_K_ENABLED=true
RRF_MIN_K=1
RRF_MAX_K=10
RRF_RELATIVE_THRESHOLD_FACTOR=0.70

# === Reranker Cross-Encoder (CPU-only, MiniLM: 10x plus rapide que BGE) ===
# Désactiver pour revenir au RAG sans rerank (uniquement RRF)
RERANKER_ENABLED=true
# Fournisseur de reranking : local (MiniLM local) ou mistral (Mistral Rerank API)
RERANKER_PROVIDER=local
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_POOL=100
RAG_MIN_PERTINENCE=0.75
RERANK_CHAR_CAP=8000
RERANK_BATCH_SIZE=16

# Early stopping : court-circuite le rerank si les scores RRF top-N sont déjà excellents
EARLY_STOP_TOP_N=5
EARLY_STOP_MEAN_THRESHOLD=0.78

# K dynamique : sélection adaptative du nombre de passages (bornes min/max)
MIN_DYNAMIC_K=2
MAX_DYNAMIC_K=12
SOFTMAX_CUM_THRESHOLD=0.80

# Guardrails statistiques : détection "bégaiement" (distribution plate → clarification forcée)
STUTTER_GAP=0.05
ZSCORE_FLAT_THRESHOLD=0.05

# === MMR (diversification pour éviter redondance) ===
MMR_ENABLED=true
MMR_K=12
MMR_LAMBDA=0.7
MMR_MAX_PER_PARENT=5