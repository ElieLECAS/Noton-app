# Copier vers .env et renseigner les valeurs obligatoires.
# Défauts : app/config.py (application) et docker-compose.yaml (conteneurs).

# --- Base et session (obligatoire) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
SECRET_KEY=
# Hors Docker seulement (Docker Compose la construit à partir des variables POSTGRES_*) :
# DATABASE_URL=postgresql://user:motdepasse@localhost:5435/lia

# --- Mistral ---
MISTRAL_API_KEY=
# MISTRAL_BASE_URL=https://api.mistral.ai
# MISTRAL_MAX_RETRIES=5
# MISTRAL_RETRY_BACKOFF_BASE=2.0

# --- Application ---
# APP_NAME=LIA
# LOG_LEVEL=INFO
# Cookie de session : true en production derrière TLS, false en local sur http://
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=lax
# Origines CORS explicites (vide = même origine seulement)
# CORS_ALLOWED_ORIGINS=
# L'utilisateur dont l'email correspond reçoit le rôle admin à la connexion
# ADMIN_EMAIL=

# --- Le chat CAG : Mistral Small 4, raisonnement, le wiki entier dans le prompt système ---
# MODEL_FAST=mistral-small-latest
# GENERATION_REASONING_EFFORT=high   (vide = sans raisonnement)
# CHAT_TEMPERATURE=0.2
# CHAT_MAX_TOKENS=4096
# Historique renvoyé au modèle après le prompt système (jamais dans le préfixe mis en cache)
# CHAT_HISTORY_MAX_MESSAGES=10
# CHAT_HISTORY_MAX_CHARS=24000
# max_tokens des appels non streamés (titres de conversation)
# MAX_COMPLETION_TOKENS=1024
# Racine de connaissance : wiki/ (les .md) et raw/ (les PDF) ; /app/wiki_llm dans le conteneur
# WIKI_DIR=wiki_llm

# --- Développement ---
# Rechargement uvicorn (interrompt les flux SSE en cours dès qu'un fichier bouge)
# UVICORN_EXTRA_ARGS=--reload
