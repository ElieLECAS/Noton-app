# Copier vers .env et renseigner les valeurs obligatoires.
# Les lignes vides utilisent les défauts de app/config.py ou docker-compose.yaml.

# --- Obligatoire (Docker Compose) ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
SECRET_KEY=

# --- Mistral (OCR, chat, embeddings API) ---
MISTRAL_API_KEY=
MISTRAL_BASE_URL=
MISTRAL_OCR_MODEL=
MISTRAL_OCR_TIMEOUT=

# --- OpenAI (optionnel) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Embeddings & ingestion (Mistral OCR + LlamaIndex hiérarchique) ---
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
EMBEDDING_BATCH_SIZE=
HIERARCHICAL_CHUNK_SIZES=
# Chunking structurel markdown : utilise MarkdownNodeParser au lieu de HierarchicalNodeParser
# Appliqué uniquement aux nouveaux documents (backward compatible)
# USE_MARKDOWN_STRUCTURED_CHUNKING=false

# Extraction PDF : forcer Mistral OCR pour tous les PDF (désactive pymupdf4llm)
# Utile pour debug ou si qualité pymupdf4llm insuffisante sur certains documents
# PDF_FORCE_OCR=false

# Profondeur de titre pour les parents de section (1 = ex. tout le bloc CATALOGUE EXTERIEURES)
# MARKDOWN_STRUCTURED_PARENT_DEPTH=1

# --- Application ---
APP_NAME=
LOG_LEVEL=INFO
MODEL_FAST=
MAX_COMPLETION_TOKENS=
CORS_ALLOWED_ORIGINS=
ADMIN_EMAIL=

# --- Chat espaces ---
SPACE_CHAT_MAX_TOKENS=
# 0.2 unifie (grounding SAV strict ; evite la broderie sur contexte CAG massif).
SPACE_CHAT_TEMPERATURE=0.2
SPACE_CHAT_TOP_P=

# --- RAG / recherche ---
RAG_TOP_K=
MIN_VECTOR_SIMILARITY=

# --- Multimodal (retraitement par page : pymupdf + mistral-small) ---
MULTIMODAL_ENABLED=
MULTIMODAL_PAGE_MODEL=mistral-small-latest
MULTIMODAL_PAGE_DPI=200
MULTIMODAL_PAGE_MAX_TOKENS=6000
VISION_MODEL=

# --- Extraction vision par page (pipeline indexation documentaire) ---
# mistral-small-latest : multimodal, transcription plus fidèle que ministral-8b
PAGE_EXTRACTION_MODEL=mistral-small-latest
PAGE_EXTRACTION_MAX_CHUNK_TOKENS=480
PAGE_EXTRACTION_MAX_CHUNKS_PER_PAGE=12
# 300 DPI : cotes des dessins techniques CAO lisibles (sinon valeurs hallucinées)
PAGE_EXTRACTION_DPI=300
PAGE_EXTRACTION_CONCURRENCY=3
PAGE_EXTRACTION_TIMEOUT=120
# Tokens max réponse JSON vision (évite troncature sur pages denses ; défaut 4096)
PAGE_EXTRACTION_MAX_TOKENS=4096

# --- Enrichissement contextuel inter-pages (synthèse factuelle par thème/catégorie) ---
CONTEXTUAL_ENRICHMENT_ENABLED=true
CONTEXTUAL_ENRICHMENT_MODEL=mistral-small-latest
CONTEXTUAL_ENRICHMENT_MAX_TOKENS=1500
CONTEXTUAL_ENRICHMENT_CONCURRENCY=2
CONTEXTUAL_ENRICHMENT_TIMEOUT=90
CONTEXTUAL_ENRICHMENT_BATCH_SIZE=3
CONTEXTUAL_ENRICHMENT_BATCH_OVERLAP=1

VISION_MAX_TOKENS=
VISION_MAX_IMAGES_PER_DOCUMENT=

# --- Recherche web (function calling, optionnel) ---
BRAVE_SEARCH_API_KEY=

# --- Base de données (local hors Docker : construire DATABASE_URL à la main) ---
# DATABASE_ECHO=

# --- Redis + Celery ---
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
# Worker Celery : 1 job document lourd à la fois (défaut compose : 1)
CELERY_WORKER_CONCURRENCY=1
# Pages multimodal traitées en parallèle dans un même document (défaut : 3)
MULTIMODAL_PAGE_CONCURRENCY=3
MULTIMODAL_NATIVE_TEXT_MIN_CHARS=100
WINDOW_MAX_INPUT_TOKENS=7000
WINDOW_MAX_PAGES=2
WINDOW_PAGE_OVERLAP=0
MAX_REPORTS_PER_WINDOW=2
MISTRAL_PASS2_TIMEOUT=60
RAG_CHUNK_OVERLAP_TOKENS=40
RETRIEVAL_EXPAND_ENABLED=true
RETRIEVAL_PAGE_RADIUS=1
RETRIEVAL_EXPAND_POOL=20
RETRIEVAL_NEIGHBOR_MIN_SCORE_RATIO=0.3
GENERATION_MAX_PAGE_IMAGES=3

# === Retrieval multimodal page-centric ===
USE_MULTIMODAL_RETRIEVAL=true
RAG_POOL_SIZE=20
RAG_NEIGHBOR_STRATEGY=conditional
SPACE_CONTEXT_MAX_PASSAGE_CHARS=4000
RAG_RENDER_ALL_IMAGES=true
RAG_MAX_IMAGES=12
RRF_K=60
# ColPali toujours actif (false = jamais court-circuite par le gating par mots-cles).
# C'est le meilleur retriever et il indexe TOUTES les pages, meme sans texte extrait.
COLPALI_GATING_ENABLED=false
COLPALI_POST_FUSION_MIN_SCORE=0.25
COLPALI_MIN_THRESHOLD=0.30
COLPALI_RELATIVE_MARGIN=0.10
COLPALI_PROTECTED_SLOTS=2
COLPALI_DOMINANCE_MIN_SCORE=0.55
COLPALI_PGVECTOR_WEAK_THRESHOLD=0.45
COLPALI_BM25_WEAK_THRESHOLD=0.25
BM25_USE_WEBSEARCH_QUERY=true
BM25_FILTER_SEMANTIC_LEAF=true
RERANK_GROUP_CHAR_CAP=2800
TASK_BACKEND_MODE=

# --- Ollama (optionnel, profile docker compose « ollama ») ---
OLLAMA_BASE_URL=

# --- LangSmith (observabilité RAG, optionnel) ---
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=
LANGCHAIN_PROJECT=

# Query understanding — extraction légère LangGraph avant retrieval RAG (boosts, pas filtres)
QUERY_UNDERSTANDING_ENABLED=false

# Boosts souples post-retrieval (signaux query understanding)
RETRIEVAL_CATEGORY_BOOST=0.15
RETRIEVAL_SOURCE_BOOST_MAX=0.8
RETRIEVAL_MATERIAL_BOOST=0.3
RETRIEVAL_ENTITY_BOOST=0.1

# --- Journal documents bibliothèque/espaces (optionnel) ---
# LIBRARY_DOCUMENT_LOG_PATH=


APP_NAME="LIA"
# mistral-small-latest = multimodal (is_vision_model le reconnaît), moins cher que large.
MODEL_FAST=mistral-small-latest
# --- KAG (graphe de connaissances : entités + relations) ---
KAG_ENABLED=true
KAG_EXTRACTION_MODEL=mistral-small-latest
KAG_EXTRACTION_CONCURRENCY=3
KAG_EXTRACTION_TIMEOUT=120
# Tokens max réponse JSON KAG (défaut 4096)
KAG_EXTRACTION_MAX_TOKENS=4096
# Plafonds globaux (prod mistral-small / ministral-12b)
KAG_MAX_ENTITIES_PER_PAGE=20
KAG_MAX_RELATIONS_PER_PAGE=15
# Plafonds auto-appliqués sur modèles compacts (ex. ministral-3b) pour éviter JSON tronqué
KAG_SMALL_MODEL_MAX_ENTITIES=8
KAG_SMALL_MODEL_MAX_RELATIONS=6
KAG_RETRIEVAL_HOP_LIMIT=1
KAG_ENTITY_MATCH_MIN_SCORE=0.35
KAG_BATCH_SIZE=3
KAG_BATCH_OVERLAP=1
CORS_ALLOWED_ORIGINS=
EMBEDDING_BATCH_SIZE=16
EMBEDDING_DIMENSION=1024
EMBEDDING_MODEL=mistral-embed
EMBEDDING_DEVICE=cpu
HIERARCHICAL_CHUNK_SIZES=1024,256
# Fenêtres glissantes sur blocs texte longs Docling (rappel)
USE_MARKDOWN_STRUCTURED_CHUNKING=true
PDF_FORCE_OCR=false
MULTIMODAL_ENABLED=true
VISION_MODEL=pixtral-12b-2409
VISION_MAX_TOKENS=1500
DOCLING_OCR_ENABLED=true
DOCLING_OCR_LANG=fr,en
DOCLING_CPU_ONLY=true
DOCLING_USE_GPU=false
OCR_IMAGE_SCALE=3.0
OCR_PREPROCESS_ENABLED=true
OCR_FALLBACK_ENABLED=true
OCR_MIN_TEXT_LENGTH=50
OCR_TESSERACT_CONFIG=--oem 3 --psm 6 -l fra+eng

# === RAG Core ===
RAG_TOP_K=10
MIN_VECTOR_SIMILARITY=0.25

# === Connaissances feedback (double recherche RAG) ===
FEEDBACK_KNOWLEDGE_TITLE_PREFIX=Connaissance technique
FAQ_TOP_K=3
FAQ_MIN_SIMILARITY=0.30
FAQ_POST_DRAFT_ENABLED=false

# === RRF Dynamique (sélection adaptative hybride) ===
RRF_DYNAMIC_K_ENABLED=true
RRF_MIN_K=1
RRF_MAX_K=10
RRF_RELATIVE_THRESHOLD_FACTOR=0.70

# === Reranker Cross-Encoder (CPU-only) — etage de PRECISION ===
# Ne pas desactiver : porte le seuil de pertinence, le K dynamique et l'abstention.
RERANKER_ENABLED=true
# Fournisseur : local (cross-encoder HF) ou mistral (Mistral Rerank API)
RERANKER_PROVIDER=local
# Modele FRANCAIS (le corpus est en francais ; ms-marco est anglais).
RERANKER_MODEL=antoinelouis/crossencoder-camembert-L2-mmarcoFR
RERANK_POOL=40
# Seuil a calibrer sur golden selon le modele de reranker choisi.
RAG_MIN_PERTINENCE=0.75
# Aligne sur max_length=512 tokens (~1800 chars FR) ; au-dela le tokenizer tronque.
RERANK_CHAR_CAP=1800
RERANK_BATCH_SIZE=16

# Early stopping : court-circuite le rerank si les scores RRF top-N sont déjà excellents
EARLY_STOP_TOP_N=5
EARLY_STOP_MEAN_THRESHOLD=0.78

# K dynamique : sélection adaptative du nombre de passages (0 = aucun passage si non pertinent)
MIN_DYNAMIC_K=0
MAX_DYNAMIC_K=12
SOFTMAX_CUM_THRESHOLD=0.80

# Guardrails statistiques : détection "bégaiement" (distribution plate → clarification forcée)
STUTTER_GAP=0.05
ZSCORE_FLAT_THRESHOLD=0.05
# Au-dessus de ce score de pertinence, le garde-fou bégaiement est ignoré : 2 passages
# EXCELLENTS et proches ne sont pas une ambiguïté (contrairement à 2 passages médiocres).
STUTTER_HIGH_CONFIDENCE_FLOOR=0.85

# === MMR (diversification pour éviter redondance) ===
MMR_ENABLED=true
MMR_K=12
MMR_LAMBDA=0.7
MMR_MAX_PER_PARENT=5

# === Reranker vision LLM (juge de pertinence page-par-page sur les PNG ColPali) ===
# Filtre le bruit des candidats ColPali avant la generation (ameliore la precision).
VISION_RERANK_ENABLED=true
# Modele vision dedie au rerank (separe de la generation). Mistral Small 4 = rapide/economique.
VISION_RERANK_MODEL=mistral-small-latest
# Seuil minimal de pertinence (echelle 0-5) pour conserver une page.
VISION_RERANK_MIN_SCORE=3
# Nombre max de pages retenues apres rerank.
VISION_RERANK_MAX_PAGES=4
# DPI de rendu PNG des pages pour le juge vision.
VISION_RERANK_DPI=150

# --- Discord Webhook Notification ---
DISCORD_WEBHOOK_URL=
# === Boucle agentique de recherche (plan_boucle_agentique_2026-07-29, lots B0-B9) ===
# Flag maitre du juge pre-generation + relances. false = pipeline strictement inchange.
AGENTIC_LOOP_ENABLED=false
# shadow = le juge tourne et trace ses verdicts sans agir (calibrage prod) ; active = il pilote.
AGENTIC_LOOP_MODE=shadow
# Deadline dure de la boucle (retrievals + juges cumules), en secondes.
LOOP_DEADLINE_S=60
# Modele du juge de suffisance ET de la verification (distinct de la generation).
MODEL_JUDGE=mistral-small-latest
# Relances de recherche max decidees par le juge (chacune = 1 retrieval + 1 juge).
JUDGE_MAX_RETRIES=2
# Timeout d un appel juge ; au-dela verdict unknown, generation inchangee.
JUDGE_TIMEOUT_S=20
# Documents candidats montres au juge (pack-juge, plus large que le pack-generation).
JUDGE_MAX_CANDIDATE_DOCS=5
# Plafond de caracteres du pack-juge (rempli par les preuves, manifeste toujours inclus).
JUDGE_CONTEXT_MAX_CHARS=24000
# Images de pages jointes au juge : off | auto (intents installation/SAV) | always.
JUDGE_IMAGES_MODE=auto
JUDGE_MAX_IMAGES=4
# Confiance minimale pour qu un verdict soit actionnable (sinon unknown).
JUDGE_MIN_CONFIDENCE=0.5

# === Verification post-generation (B7) ===
# Flag maitre (avant ce lot, la verification tournait toujours et sans effet).
VERIFY_ENABLED=true
# Modele de verification ; vide = MODEL_JUDGE. Jamais le modele de generation.
VERIFY_MODEL=
# true = generation en tampon, verification AVANT emission, reparation possible.
VERIFY_BLOCKING=false
# buffer (v1) | stream_correct (reserve, retombe sur buffer).
VERIFY_EMIT_MODE=buffer
# Reparations max apres echec de verification en mode bloquant.
VERIFY_MAX_REPAIRS=1
# Controle programmatique des codes produits de la reponse (cas TGY3710) — zero LLM.
VERIFY_CODE_GROUNDING=true
# Quota par document aussi sur le chemin reranke (le juge doit avoir a comparer).
RERANK_PER_DOC_QUOTA_ENABLED=true
